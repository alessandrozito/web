questionnaire_path <- "~/Downloads/BAYSM2026 travel support questionnaire.xlsx"
questionnaire <- read_excel(questionnaire_path, sheet = "Form Responses 1")
# --- Build a normalized join key -------------------------------------------
# The two files name their columns differently ("First name"/"Last name" vs
# "First Name"/"Last Name") and several entries have stray spaces or differing
# capitalization (e.g. "Aljo Clair " vs "aljo clair"). Normalizing avoids
# missed matches: trim, collapse internal whitespace, and lowercase.
norm <- function(x) {
x <- as.character(x)
x <- trimws(x)                 # strip leading/trailing spaces
x <- gsub("\\s+", " ", x)      # collapse multiple internal spaces
tolower(x)                     # case-insensitive
}
questionnaire <- questionnaire %>%
mutate(
.first_key = norm(`First name`),
.last_key  = norm(`Last name`)
)
participants <- participants %>%
mutate(
.first_key = norm(`First Name`),
.last_key  = norm(`Last Name`)
)
questionnaire
# --- Merge ------------------------------------------------------------------
# Default: keep every questionnaire respondent (the travel-support applicants)
# and attach their participant details where a name match exists.
#   left_join  -> all questionnaire rows (default below)
#   inner_join -> only people present in BOTH files
#   full_join  -> everyone from either file
# Columns present in both files (e.g. Affiliation) are suffixed .questionnaire
# / .participants so nothing is silently overwritten.
merged <- questionnaire %>%
full_join(
participants,
by = c(".first_key", ".last_key"),
suffix = c(".questionnaire", ".participants")
) %>%
select(-.first_key, -.last_key)   # drop the helper keys from the output
matched   <- sum(!is.na(merged$`First Name`))   # a participants-only column
unmatched <- nrow(merged) - matched
cat(sprintf("Questionnaire respondents : %d\n", nrow(questionnaire)))
cat(sprintf("Participants on file      : %d\n", nrow(participants)))
cat(sprintf("Matched to a participant  : %d\n", matched))
cat(sprintf("No participant match      : %d\n", unmatched))
write_xlsx(merged, "~/Downloads/BAYSM_2026_merged.xlsx")
