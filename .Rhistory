base     <- "https://ftp.sanger.ac.uk/pub/cancer/Nik-ZainalEtAl-560BreastGenomes/CopyNumber/Breast80/"
dest_dir <- path.expand("~/Downloads/copyNumber80Breast")
dir.create(dest_dir, recursive = TRUE, showWarnings = FALSE)
options(timeout = 600)
idx <- readLines(base, warn = FALSE)
files <- unique(unlist(regmatches(idx, gregexpr("[A-Za-z0-9._-]+\\.csv", idx))))
cat("Found", length(files), "CSV files\n")
# 3. Download each into the target folder
for (f in files) {
tryCatch(
download.file(paste0(base, f), file.path(dest_dir, f), mode = "wb", quiet = TRUE),
error = function(e) message("Failed: ", f, " (", conditionMessage(e), ")")
)
}
